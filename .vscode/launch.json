{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++ Debug: Remote Launch with gdbserver",
            "type": "cppdbg",
            "request": "launch",
            "program": "enter program name, for example: ${workspaceFolder}/a.out",
            "stopAtEntry": true,
            "stopAtConnect": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerServerAddress": "gdbserverHostIp:port",
            "sourceFileMap": {
                "/original/source/path": "${workspaceFolder}"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open sih.html",
            "file": "d:\\Programs\\sih.html"
        }
    ]
}